# Whysho EQ1 license server — environment variables
# Copy to `.env` and fill in real values. `.env` is gitignored.

# Ed25519 private key (hex, 64 chars) used to SIGN license tokens.
# Generate with: npm run keygen
# KEEP SECRET. In production, inject from a secret manager — never commit it.
# For LOCAL DEV ONLY you can use the disposable key in keys/DEV_PRIVATE_KEY.txt.
WHYSHO_LICENSE_PRIVATE_KEY=<64-hex-char-ed25519-private-key>

# Shared secret required by admin endpoints (x-admin-token header).
WHYSHO_ADMIN_TOKEN=<choose-a-long-random-admin-token>

# --- Optional (defaults shown) ---
# HOST=0.0.0.0
# PORT=8787
# WHYSHO_DB_PATH=./data/licenses.db
# WHYSHO_DEFAULT_SEATS=2
# WHYSHO_RATE_LIMIT_MAX=60
# WHYSHO_RATE_LIMIT_WINDOW_MS=60000
# LOG_LEVEL=info

{
  "name": "whysho-eq1-license-server",
  "version": "1.0.0",
  "private": true,
  "description": "License activation server for the Whysho EQ1 audio plugin (VST3/AU). Issues Ed25519-signed license tokens.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "keygen": "tsx scripts/keygen.ts",
    "issue-test-license": "tsx scripts/issue-test-license.ts",
    "typecheck": "tsc -p tsconfig.all.json"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.2.2",
    "@noble/ed25519": "^2.1.0",
    "@noble/hashes": "^1.6.1",
    "better-sqlite3": "^11.8.1",
    "fastify": "^5.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
